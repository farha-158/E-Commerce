<%#
  Reset-password OTP template (EJS, email-safe: tables + inline CSS, no JS, no icon fonts).
  Variables:
    code            string   required  6-digit OTP
    email           string   required  recipient address
    appName         string   required  brand name
    expiresMinutes  number   required
    year            number   required
    name            string   optional  user's name (falls back to "there")
    actionUrl       string   optional  absolute https:// link; shows a button when provided
-%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Reset your password</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      body { margin: 0; padding: 0; }
      @media only screen and (max-width: 480px) {
        .container { padding: 28px 20px !important; }
        .otp-panel { padding: 20px 10px !important; }
        .digit { width: 34px !important; height: 46px !important; line-height: 46px !important; font-size: 22px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#f2f3ff;font-family:Inter,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#131b2e;">
    <!-- Inbox preview text -->
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      Your password reset code is <%= code %>. It expires in <%= expiresMinutes %> minutes.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f3ff;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="580" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:580px;background-color:#ffffff;border-radius:12px;">
            <tr>
              <td class="container" style="padding:40px;">
                <!-- Header -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="32" valign="middle">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="center" width="32" height="32" style="width:32px;height:32px;background-color:#2563eb;border-radius:8px;color:#ffffff;font-size:16px;font-weight:700;line-height:32px;">
                            <%= appName.charAt(0).toUpperCase() %>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td valign="middle" style="padding-left:10px;font-size:18px;font-weight:700;color:#131b2e;letter-spacing:-0.005em;"><%= appName %></td>
                    <td align="right" valign="middle">
                      <span style="display:inline-block;background-color:#eaedff;color:#434655;font-size:11px;line-height:14px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;padding:5px 10px;border-radius:12px;">Account Recovery</span>
                    </td>
                  </tr>
                </table>

                <!-- Hero -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:32px;">
                  <tr>
                    <td align="center">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="center" width="64" height="64" style="width:64px;height:64px;background-color:#dbe1ff;border-radius:32px;font-size:30px;line-height:64px;">&#128273;</td>
                        </tr>
                      </table>
                      <h1 style="margin:16px 0 0;font-size:32px;line-height:40px;font-weight:600;letter-spacing:-0.015em;color:#131b2e;">Reset your password</h1>
                      <p style="margin:8px 0 0;max-width:440px;font-size:14px;line-height:22px;color:#434655;">
                        Hi <strong style="color:#131b2e;font-weight:600;"><%= locals.name || 'there' %></strong>,
                        enter this one-time passcode (OTP) to reset the password for your <%= appName %> account
                        (<strong style="color:#131b2e;font-weight:600;"><%= email %></strong>).
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- OTP panel -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;">
                  <tr>
                    <td class="otp-panel" align="center" style="background-color:#f2f3ff;border:1px solid #c3c6d7;border-radius:12px;padding:24px;">
                      <div style="font-size:11px;line-height:14px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:#434655;">One-Time Password (OTP)</div>

                      <table role="presentation" align="center" cellpadding="0" cellspacing="6" border="0" style="margin:14px auto 8px;">
                        <tr>
                          <% String(code).split('').forEach(function (d, i) { %>
                            <% if (i === 3) { %>
                              <td align="center" style="color:#737686;font-size:20px;font-weight:700;padding:0 2px;">-</td>
                            <% } %>
                            <td class="digit" align="center" style="width:44px;height:52px;background-color:#ffffff;border:1px solid #c3c6d7;border-radius:8px;color:#004ac6;font-size:26px;line-height:52px;font-weight:700;font-family:'SFMono-Regular',Menlo,Consolas,'Courier New',monospace;"><%= d %></td>
                          <% }); %>
                        </tr>
                      </table>

                      <!-- Plain copy of the code: easy to select and detected by phone autofill -->
                      <div style="font-size:12px;line-height:16px;color:#434655;">
                        Your code: <strong style="color:#131b2e;letter-spacing:0.08em;"><%= code %></strong>
                      </div>

                      <div style="margin-top:14px;font-size:12px;line-height:16px;color:#434655;">
                        &#9201;&nbsp;This code expires in <strong style="color:#131b2e;font-weight:600;"><%= expiresMinutes %> minutes</strong>. Single-use only.
                      </div>
                    </td>
                  </tr>
                </table>

                <% if (locals.actionUrl) { %>
                <!-- Optional action button -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                  <tr>
                    <td align="center">
                      <a href="<%= actionUrl %>" style="display:inline-block;background-color:#2563eb;color:#ffffff;text-decoration:none;font-size:14px;line-height:20px;font-weight:600;padding:12px 28px;border-radius:8px;">Reset password &rarr;</a>
                    </td>
                  </tr>
                </table>
                <% } else { %>
                <p style="margin:12px 0 0;text-align:center;font-size:12px;line-height:16px;color:#434655;">
                  Enter this code on the <%= appName %> password recovery page.
                </p>
                <% } %>

                <!-- Didn't request this? -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;">
                  <tr>
                    <td style="background-color:#ffdad6;border-radius:8px;padding:18px;">
                      <div style="font-size:15px;line-height:22px;font-weight:600;color:#ba1a1a;">&#128737;&#65039; Didn't request a password reset?</div>
                      <p style="margin:8px 0 0;font-size:12px;line-height:18px;color:#131b2e;">
                        If you didn't ask for this, someone may be trying to access your account.
                        <strong style="font-weight:600;">Your password stays the same unless this code is used.</strong>
                        You can safely ignore this email.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Password tips -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;">
                  <tr>
                    <td style="background-color:#f2f3ff;border-radius:8px;padding:16px;">
                      <div style="font-size:11px;line-height:14px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:#434655;">Choosing a new password</div>
                      <p style="margin:8px 0 0;font-size:12px;line-height:20px;color:#434655;">
                        <span style="color:#004ac6;">&#10003;</span>&nbsp; At least 8 characters<br />
                        <span style="color:#004ac6;">&#10003;</span>&nbsp; A mix of upper and lower case letters and a number<br />
                        <span style="color:#004ac6;">&#10003;</span>&nbsp; Not reused from any other account
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Footer -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:32px;">
                  <tr>
                    <td align="center" style="border-top:1px solid #eaedff;padding-top:24px;">
                      <p style="margin:0;font-size:11px;line-height:16px;color:#737686;">
                        You received this security notice because a password reset was requested for your account.
                        Never forward this email or share your code with anyone.
                      </p>
                      <p style="margin:12px 0 0;font-size:12px;line-height:16px;color:#737686;">&copy; <%= year %> <%= appName %></p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
